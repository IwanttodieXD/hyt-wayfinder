# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Required for admin user create/delete (/api/admin/users) and for the visitor
# sign-in on the verification page (/api/verify), which mints a session without
# sending email. Without it, /verify falls back to a front-desk message.
# Server-only: never prefix this with NEXT_PUBLIC_, or it ships to the browser.
# Supabase dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=""

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/hyt_vms?schema=public"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notifications (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@hyt.com"

# QR Code Settings
QR_EXPIRY_HOURS="24"
