# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Required for admin user create/archive (/api/admin/users) and for visitor
# sign-in on the verification page (/api/verify), which mints a session without
# sending email. Without it, both features return 501 and read/update still work.
# Server-only: never prefix this with NEXT_PUBLIC_, or it ships to the browser.
# Supabase dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=""

# Application
# Used to build absolute links (verification/registration QR targets). Set this
# to the deployed origin in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
